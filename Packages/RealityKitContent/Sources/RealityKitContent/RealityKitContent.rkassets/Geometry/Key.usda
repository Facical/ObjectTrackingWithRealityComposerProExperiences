#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (445.0.0.0.2)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root" (
    references = None
)
{
    reorder nameChildren = ["Mesh", "InputTarget", "Collider", "Emitter", "InvisibleMaterial"]
    quatf xformOp:orient = (1, 0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    float3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Material "InvisibleMaterial" (
        references = None
    )
    {
        token outputs:mtlx:surface.connect = </Root/InvisibleMaterial/PreviewSurface.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/Anchor/Keys/InvisibleMaterial/DefaultSurfaceShader.outputs:surface>
        float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (0, 110.5)

        def Shader "DefaultSurfaceShader" (
            active = false
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }

        def Shader "PreviewSurface" (
            references = None
        )
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor = (0.98924905, 0.9762979, 0.9993475) (
                colorSpace = "srgb_displayp3"
            )
            color3f inputs:emissiveColor = (0, 0, 0) (
                colorSpace = "srgb_displayp3"
            )
            float inputs:occlusion = 0
            float inputs:opacity = 0
            token outputs:out
            float2 ui:nodegraph:node:pos = (-255, 105)
            int ui:nodegraph:node:stackingOrder = 26
            string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced"]
        }
    }

    def Cube "Mesh" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = None
    )
    {
        rel material:binding = </Root/InvisibleMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double size = 0.2
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.074, 0.074, 0.074)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "HierarchicalFade"
        {
            uniform token info:id = "RealityKit.HierarchicalFade"
            float opacity = 1
        }
    }

    def RealityKitComponent "InputTarget"
    {
        uniform token info:id = "RealityKit.InputTarget"
    }

    def RealityKitComponent "Collider"
    {
        uint group = 1
        uniform token info:id = "RealityKit.Collider"
        uint mask = 4294967295
        token type = "Default"

        def RealityKitStruct "Shape"
        {
            float3 extent = (0.0148, 0.0148, 0.0148)
            token shapeType = "Box"

            def RealityKitStruct "pose"
            {
            }
        }
    }

    def Xform "Emitter" (
        references = None
    )
    {
        def RealityKitComponent "VFXEmitter"
        {
            token info:id = "RealityKit.VFXEmitter"

            def RealityKitStruct "currentState"
            {
                bool isEmitting = 0
                float3 shapeSize = (0.001, 0.001, 0.001)

                def RealityKitStruct "mainEmitter"
                {
                    double particleLifeSpan = 0.15
                    float particleSize = 0.01
                }

                def RealityKitStruct "spawnedEmitter"
                {
                }
            }
        }
    }
}

