        )
        double size = 0.2
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.02, 0.3, 0.03)
        float3 xformOp:translate = (-0.042749092, 0.029928938, 1.3969839e-9)
