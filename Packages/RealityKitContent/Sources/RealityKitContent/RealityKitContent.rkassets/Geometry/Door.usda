    }

    def Cube "Cube_3" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = None
    )
    {
        reorder nameChildren = ["Scratched_Metallic_Paint", "Maple_Plywood"]
        rel material:binding = </Root/Cube_3/Scratched_Metallic_Paint> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double size = 0.2
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.02, 0.3, 0.03)
        float3 xformOp:translate = (0.04253959, 0.029928938, 1.3969839e-9)
